<%
  var all = site.categories.toArray();
  var roots = all.filter(function(c){ return !c.parent; }).sort(function(a,b){ return b.length - a.length; });
  var subs = all.filter(function(c){ return c.parent; });
%>
<div class="wrap narrow">
  <div class="page-head">
    <h1>分类</h1>
    <p><%= roots.length %> 个大类 · <%= subs.length %> 个子类 · 共 <%= site.posts.length %> 篇</p>
  </div>
  <ul class="cat-tree">
    <% roots.forEach(function(c){
         var kids = subs.filter(function(s){ return s.parent === c._id; })
                        .sort(function(a,b){ return b.length - a.length; }); %>
      <li>
        <a class="root" href="<%= url_for(c.path) %>">
          <b><%= c.name %></b><span><%= c.length %></span>
        </a>
        <% if (kids.length) { %>
        <p class="kids">
          <% kids.forEach(function(k){ %>
            <a href="<%= url_for(k.path) %>"><%= k.name %><span><%= k.length %></span></a>
          <% }); %>
        </p>
        <% } %>
      </li>
    <% }); %>
  </ul>
</div>
