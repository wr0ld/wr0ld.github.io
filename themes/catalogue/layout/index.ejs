<%
  // 首页：按年份分组的双栏索引
  var groups = {};
  var order = [];
  page.posts.each(function (post) {
    var y = date(post.date, 'YYYY');
    if (!groups[y]) { groups[y] = []; order.push(y); }
    groups[y].push(post);
  });
%>
<div class="wrap">
  <div class="home-head">
    <h1 class="serif"><%- (theme.hero && theme.hero.title) || '代码审计与渗透测试笔记' %><i class="accent-dot">.</i></h1>
    <div class="hero-meta">
      <span><b><%= site.posts.length %></b> 篇</span>
      <span>最近更新 <b><%- date(page.posts.first().date, 'YYYY.MM.DD') %></b></span>
      <span>分类 <b><%= site.categories.toArray().filter(function (c) { return !c.parent; }).length %></b> · 标签 <b><%= site.tags.length %></b></span>
    </div>
  </div>

  <% if (order.length > 1) { %>
    <% order.forEach(function (y) { %>
      <section class="year-set">
        <div class="year-bar"><b><%= y %></b><span><%= groups[y].length %> 篇</span></div>
        <ol class="posts two">
          <% groups[y].forEach(function (post) { %>
            <%- partial('_partial/post-item', { post: post }) %>
          <% }); %>
        </ol>
      </section>
    <% }); %>
  <% } else { %>
    <ol class="posts two solo">
      <% page.posts.each(function (post) { %>
        <%- partial('_partial/post-item', { post: post }) %>
      <% }); %>
    </ol>
  <% } %>

  <% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">← 上一页</a><% } %>
    <span class="cur"><%= page.current %> / <%= page.total %></span>
    <span class="sp"></span>
    <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">下一页 →</a><% } %>
  </nav>
  <% } %>
</div>
