<%
  // 首页：一行标题 + 文章列表，没有自述、没有侧栏
  var posts = page.posts;
  var all = site.posts.toArray();
  var years = all.length
    ? date(all[all.length - 1].date, 'YYYY') + '—' + date(all[0].date, 'YYYY')
    : '';
%>
<div class="wrap">
  <div class="home-head">
    <h1 class="serif"><%- (theme.hero && theme.hero.title) || '代码审计与渗透测试笔记' %></h1>
    <span class="stat">共 <%= all.length %> 篇</span>
  </div>

  <ol class="posts">
    <% posts.each(function(post){ %>
      <%- partial('_partial/post-item', { post: post }) %>
    <% }); %>
  </ol>

  <% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">← 上一页</a><% } %>
    <span class="cur"><%= page.current %> / <%= page.total %></span>
    <span class="sp"></span>
    <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">下一页 →</a><% } %>
  </nav>
  <% } %>
</div>
