<%
  var tags = site.tags.toArray().sort(function(a,b){ return b.length - a.length; });
%>
<div class="wrap narrow">
  <div class="page-head">
    <h1>标签</h1>
    <p>共 <%= tags.length %> 个标签。</p>
  </div>
  <div class="tag-cloud">
    <% tags.forEach(function(t){ %>
      <a href="<%= url_for(t.path) %>"><%= t.name %><sup><%= t.length %></sup></a>
    <% }); %>
  </div>
</div>
