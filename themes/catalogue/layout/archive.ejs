<%
  // 归档：先按年，再按月分组
  var years = {};
  page.posts.each(function(post){
    var y = date(post.date, 'YYYY');
    var m = date(post.date, 'MM');
    years[y] = years[y] || { months: {}, count: 0 };
    years[y].months[m] = years[y].months[m] || [];
    years[y].months[m].push(post);
    years[y].count++;
  });
  var yearKeys = Object.keys(years).sort().reverse();
%>
<div class="wrap narrow">
  <div class="page-head">
    <h1>归档</h1>
    <p>共 <%= site.posts.length %> 篇，按年月倒序。</p>
  </div>
  <div class="archive">
  <% yearKeys.forEach(function(y){ %>
    <section class="year-block">
      <div class="year-h"><b><%= y %></b><span><%= years[y].count %> 篇</span></div>
      <% Object.keys(years[y].months).sort().reverse().forEach(function(m){ %>
        <div class="month-block">
          <div class="month-h"><span><%= m %> 月</span><i></i><em><%= years[y].months[m].length %> 篇</em></div>
          <ol class="posts two">
            <% years[y].months[m].forEach(function(post){ %>
              <%- partial('_partial/post-item', { post: post, dayOnly: true }) %>
            <% }); %>
          </ol>
        </div>
      <% }); %>
    </section>
  <% }); %>
  </div>
  <% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">← 上一页</a><% } %>
    <span class="cur"><%= page.current %> / <%= page.total %></span>
    <span class="sp"></span>
    <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">下一页 →</a><% } %>
  </nav>
  <% } %>
</div>
