<%
  var cur = page.path || '';
  var navItems = theme.nav || [];
%>
<header class="bar wrap">
  <a class="mark serif" href="<%= url_for('/') %>"><%= config.author %></a>
  <nav class="links">
    <% navItems.forEach(function(item){ %>
      <% var on = (item.url === '/' && cur === 'index.html') || (item.url !== '/' && cur.indexOf(item.url.replace(/^\//,'')) === 0); %>
      <a href="<%- url_for(item.url) %>"<%- on ? ' class="on"' : '' %>><%= item.title %></a>
    <% }); %>
    <span class="admin-only">
      <a href="/lab/">实验室</a>
      <a href="/gallery/">相册</a>
      <a href="/games/">游戏</a>
      <a href="#" data-cards>卡牌</a>
    </span>
    <span class="find">
      <input id="searchInput" type="search" placeholder="搜索" autocomplete="off" aria-label="站内搜索">
      <ul class="find-res" id="searchRes"></ul>
    </span>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="切换明暗">◐</button>
  </nav>
</header>
