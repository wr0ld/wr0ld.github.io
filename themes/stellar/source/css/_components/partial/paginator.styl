.paginator-wrap
  margin: 0.25rem 1rem
  display: flex
  justify-content: space-between
  align-items: center
  font-size: 1rem
  font-weight: 700
  background: var(--card)
  border-radius: $border-card-l
  overflow: hidden
  box-shadow: 0 2px 8px 0px rgba(0, 0, 0, 0.03)
  color: var(--text-p3)
  gap: 6px
  padding: 4px
  .page-number
    flex: 1
    text-align: center
    padding: 6px 10px
    border-radius: 10px
    margin: 0
    transition: all 0.2s ease
  a.page-number
    color: var(--text-p3)
    &:hover
      color: var(--text-p1)
      background: var(--block)
      transform: translateY(-1px)
  .extend
    flex: 0 0 auto
    text-align: center
    background-size: contain
    width: 1.8rem
    height: 1.8rem
    background-origin: content-box
    background-clip: content-box
    border-radius: 10px
    margin: 0
    &.next
      background-image: url(hexo-config('style.paginator.next'))
    &.prev
      background-image: url(hexo-config('style.paginator.prev'))
  .current
    font-family: $ff-code
    background: var(--block)
    color: var(--text-p1)
    font-weight: bold
  .extend
    padding: 0.5rem
    line-height: 0
    filter: grayscale(100%)
    img
      height: 1rem
    &.disable
      pointer-events: none
  span.extend
    opacity: 0.25
  a.extend
    position: relative
    backdrop-filter: blur(8px)
    -webkit-backdrop-filter: blur(8px)
    border: 1px solid transparent
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    &:hover
      background-color: rgba(255, 255, 255, 0.08)
      border-color: rgba(255, 255, 255, 0.15)
      transform: translateY(-2px) scale(1.05)
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.15)