.widget-wrapper.toc
  z-index 3
  position relative
  overflow visible

  // 背景毛玻璃效果
  background: var(--background)
  border: 1px solid var(--block-border)
  border-radius: 12px
  backdrop-filter: blur(10px)
  -webkit-backdrop-filter: blur(10px)
  box-shadow: 0 2px 12px rgba(0,0,0,0.06)

  .widget-body
    position relative
    &:before
      content: ''
      position absolute
      top: 8px
      bottom: 8px
      left: 16px
      width: 2px
      background: var(--block-border)
      border-radius: 2px

// 目录基本样式
.widget-wrapper.toc .toc
  --fsp: $fsp2
  padding: 0
  margin: 0
  position relative
  list-style: none
  li
    margin: 0
    list-style: none
  a
    --padding: calc(var(--gap-padding) / 2)
    --padding-offset: calc(0 - var(--padding))
    padding: 6px var(--padding)
    padding-left: 28px
    margin: 1px 8px
    color: var(--text-p3)
    display: block
    position relative
    border-radius: 6px
    trans1 all
    font-weight: 400
    letter-spacing: 0.2px
    overflow: hidden

    // 背景水波纹效果
    &::after
      content: ''
      position: absolute
      inset: 0
      border-radius: 6px
      background: linear-gradient(135deg, var(--theme), #7B2FBE)
      opacity: 0
      transform: scaleX(0.8) scaleY(0.3)
      trans1 all
      z-index: -1

    &:hover
      color: var(--text)
      background: var(--block-border)
      transform: translateX(3px)

    // 激活状态 - 霓虹光效
    &.active
      color: #fff !important
      font-weight: 500
      text-shadow: 0 0 8px rgba(123, 47, 190, 0.3)
      transform: translateX(4px)

      &::after
        opacity: 1
        transform: scaleX(1) scaleY(1)

      // 左侧发光指示器
      &:before
        content: ''
        position: absolute
        top: 50%
        left: 0
        transform: translateY(-50%)
        width: 3px
        height: 18px
        background: linear-gradient(180deg, #4A90D9, #7B2FBE)
        border-radius: 2px
        box-shadow: 0 0 8px rgba(74, 144, 217, 0.5), 0 0 16px rgba(123, 47, 190, 0.3)
        animation: tocGlow 2s ease-in-out infinite

// 霓虹光脉冲动画
@keyframes tocGlow
  0%, 100%
    box-shadow: 0 0 8px rgba(74, 144, 217, 0.5), 0 0 16px rgba(123, 47, 190, 0.3)
  50%
    box-shadow: 0 0 12px rgba(74, 144, 217, 0.7), 0 0 24px rgba(123, 47, 190, 0.5)

// 左侧背景竖线装饰
.widget-wrapper.toc .widget-body
  &::after
    content: ''
    position: absolute
    top: 8px
    bottom: 8px
    left: 16px
    width: 2px
    background: linear-gradient(180deg, #4A90D9 0%, #7B2FBE 50%, transparent 100%)
    border-radius: 2px
    opacity: 0
    trans1 all

.widget-wrapper.toc .widget-body:has(a.active)
  &::after
    opacity: 1

// 固定位置
.l_right .widgets .widget-wrapper.toc
  margin-top: 0
  position: sticky
  position: -webkit-sticky
  top: calc(var(--gap-margin) * 1)
  padding: 12px 0
  &:first-child
    top: calc(var(--gap-margin) * 2)
    padding-top: 1rem
  .widget-body .toc
    max-height: 70vh
    @media screen and (max-width: $device-desktop)
      max-height: 60vh
    @media screen and (max-width: $device-laptop)
      max-height: unset
    overflow: auto
    scrollbar(0, 0)

// 各级缩进样式
.widget-wrapper.toc .toc
  .toc-item
    font-weight: 500
    --fsp: $fsp2
  .toc-item .toc-item
    font-weight: 400
    --fsp: $fsp3
  ol
    padding-left: 0
  .toc-child
    overflow: hidden
    trans1 all
  .toc-child .toc-link
    padding-left: 40px
  .toc-child .toc-child .toc-link
    padding-left: 52px
  .toc-child .toc-child .toc-child .toc-link
    padding-left: 64px
  .toc-child .toc-child .toc-child .toc-child .toc-link
    padding-left: 76px
  .toc-child .toc-child .toc-child .toc-child .toc-child .toc-link
    padding-left: 88px

// 高亮样式
.widget-wrapper.toc .toc a.toc-link.active
  color: #fff
  &:before,&:after
    content: ''

// 子目录展开/折叠动画
.widget-wrapper.toc[collapse='true'],
.widget-wrapper.toc[collapse='auto']
  .toc-item a.toc-link+ol
    max-height: 0
    opacity: 0
    overflow: hidden
    trans1 all
    transform: translateY(-4px)
  .toc a.toc-link.active+ol
    max-height: 300px
    opacity: 1
    transform: translateY(0)

.widget-wrapper.toc[collapse='auto']
  &:hover a.toc-link+ol
    max-height: 300px
    opacity: 1
    transform: translateY(0)

// 子目录激活时显示
.widget-wrapper.toc[collapse='true'] ol:has(> .toc-item a.active),
.widget-wrapper.toc[collapse='auto'] ol:has(> .toc-item a.active)
  max-height: 300px
  opacity: 1
  transform: translateY(0)

// 折叠/展开按钮
.widget-wrapper.toc .widget-header
  cursor: pointer
  user-select: none

.widget-wrapper.toc
  .widget-body
    display: grid
    grid-template-rows: 1fr
    trans1 all
    overflow hidden

.l_right .widgets .widget-wrapper.toc.collapse
  .widget-body
    grid-template-rows: 0fr

// 编辑本文按钮
.widget-wrapper.toc .widget-body+.widget-footer:before
  content: ''
  position absolute
  background: var(--block-border)
  top: 0
  height: 1px
  left: var(--gap-padding)
  right: var(--gap-padding)

.widget-wrapper.toc .widget-footer
  margin-top: 8px
  color: var(--text-p2)
  position relative
  padding-top: 8px
  a
    display: flex
    align-items: center
    color: inherit
    font-size: $fs-14
    padding: 8px var(--gap-padding)
    border-radius: 6px
    trans1 all
    svg,img
      height: 16px
      width: auto
      margin-right: 8px
  a:hover
    background: var(--block)
    color: var(--text)

.widget-wrapper.toc+.widget-wrapper
  padding-top: 32px

@media screen and (max-width: $device-laptop)
  .l_right
    blur-effect()
    .widgets
      .widget-wrapper.toc
        position: static
        background: none
        border: none
        backdrop-filter: none
        box-shadow: none
  .widget-wrapper.toc .toc
    a
      color: var(--text-p2)
  .widget-wrapper.toc .widget-footer
    a
      background: var(--block)
    a+a
      margin-top: 4px
