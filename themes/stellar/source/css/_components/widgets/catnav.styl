.l_right .widget-wrapper.catnav
  margin: 0 0 16px
  padding: 18px 16px 20px
  border-radius: 26px
  background: linear-gradient(180deg, rgba(58, 82, 122, 0.58), rgba(14, 38, 64, 0.76))
  border: 1px solid rgba(118, 170, 230, 0.22)
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.10), 0 18px 44px rgba(0,0,0,0.28), 0 0 26px rgba(37, 151, 255, 0.10)
  backdrop-filter: blur(14px)

  .widget-header
    height: 36px
    padding: 0 4px 10px
    margin-bottom: 8px
    display: flex
    align-items: center
    justify-content: center
    color: rgba(225, 239, 255, 0.78)
    font-weight: 700
    letter-spacing: .04em
    border-bottom: 1px solid rgba(130, 178, 240, 0.14)

    &:before
      content: ''
      width: 8px
      height: 8px
      margin-right: 10px
      border-radius: 50%
      background: linear-gradient(135deg, #42a5ff, #8a48ff)
      box-shadow: 0 0 12px rgba(84, 156, 255, 0.65)

    .name
      color: inherit

  .widget-body
    position relative
    max-height: calc(100vh - 170px)
    overflow-y: auto
    padding-right: 4px

    &::-webkit-scrollbar
      width: 4px
    &::-webkit-scrollbar-thumb
      background: rgba(125, 170, 220, 0.28)
      border-radius: 999px

    &:before
      content: ''
      position absolute
      top: 12px
      bottom: 12px
      left: 12px
      width: 2px
      background: linear-gradient(180deg, rgba(68, 161, 255, 0.58), rgba(132, 64, 255, 0.18))
      border-radius: 2px

  .catnav-list
    padding: 4px 0 0
    margin: 0

  .catnav-group
    margin: 2px 0 8px

  .catnav-link
    padding: 9px 12px 9px 28px
    margin: 1px 0 2px
    color: rgba(228, 240, 255, 0.82)
    display: flex
    align-items: center
    gap: 10px
    border-radius: 12px
    text-decoration: none
    position: relative
    trans1 all

    &:before
      content: ''
      position: absolute
      left: 8px
      top: 50%
      width: 7px
      height: 7px
      border-radius: 50%
      transform: translateY(-50%)
      background: rgba(96, 167, 255, 0.45)
      box-shadow: 0 0 0 4px rgba(96, 167, 255, 0.08)

    .catnav-name
      flex: 1
      font-size: 14px
      font-weight: 600

    .catnav-count
      min-width: 26px
      padding: 2px 7px
      border-radius: 999px
      text-align: center
      font-size: 11px
      color: rgba(228, 240, 255, 0.72)
      background: rgba(255,255,255,0.06)
      font-family: $ff-code
      flex-shrink: 0

    &:hover
      color: #fff
      background: rgba(96, 167, 255, 0.12)
      transform: translateX(2px)

    &.active
      color: #fff !important
      font-weight: 700
      background: linear-gradient(135deg, rgba(55, 150, 255, 0.86), rgba(126, 58, 210, 0.86))
      box-shadow: 0 8px 18px rgba(41, 123, 220, 0.20)

      &:before
        background: #fff
        box-shadow: 0 0 12px rgba(255,255,255,0.70)

      .catnav-count
        color: rgba(255,255,255,0.86)
        background: rgba(255,255,255,0.14)

  // 子分类
  .catnav-child
    padding: 7px 12px 7px 42px
    margin: 1px 0
    color: rgba(205, 224, 246, 0.62)
    display: flex
    align-items: center
    gap: 10px
    border-radius: 10px
    text-decoration: none
    font-size: 13px
    position: relative
    trans1 all

    &:before
      content: ''
      position: absolute
      left: 28px
      top: 50%
      width: 6px
      height: 1px
      transform: translateY(-50%)
      background: rgba(120, 173, 232, 0.30)

    .catnav-child-name
      flex: 1

    .catnav-child-count
      min-width: 22px
      text-align: center
      font-size: 10px
      color: rgba(205, 224, 246, 0.58)
      font-family: $ff-code
      flex-shrink: 0

    &:hover
      color: rgba(255,255,255,0.88)
      background: rgba(255,255,255,0.06)
      transform: translateX(2px)

    &.active
      color: #fff !important
      background: rgba(64, 145, 255, 0.18)
      font-weight: 600

      .catnav-child-count
        color: rgba(255,255,255,0.78)
