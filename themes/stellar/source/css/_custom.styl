// 顶部「近期发布 / 分类 / 归档」去掉厚重胶囊框，改成轻量标签栏。
html
  scroll-behavior: smooth

.navbar
  top: 18px

.navbar-blur
  margin: 0 !important
  border: none !important
  border-radius: 0 !important
  background: transparent !important
  box-shadow: none !important
  text-shadow: none !important
  backdrop-filter: none !important
  -webkit-backdrop-filter: none !important
  &:before,
  &:after
    display: none !important
    content: none !important

.navbar-container
  margin: 0 !important
  border-radius: 0 !important
  overflow-x: auto !important
  overflow-y: hidden !important
  scrollbar-width: none
  &::-webkit-scrollbar
    display: none

.navbar nav.post
  align-items: center
  min-height: 34px
  gap: 18px
  padding: 0 2px
  border-bottom: none !important

.navbar nav.post a
  margin: 0 !important
  padding: 0 0 0.48rem !important
  border-radius: 0 !important
  color: rgba(235, 242, 255, 0.46) !important
  background: transparent !important
  box-shadow: none !important
  border: none !important
  font-size: 0.86rem
  font-weight: 520
  line-height: 1.4
  letter-spacing: 0.02em
  text-shadow: none !important
  filter: none !important
  transition: color 0.16s ease
  &:hover
    color: rgba(245, 249, 255, 0.92) !important
    background: transparent !important
  &.active
    color: rgba(245, 249, 255, 0.94) !important
    background: transparent !important
    pointer-events: none
    &:after
      content: ''
      position: absolute
      left: 0
      right: 0
      bottom: 0
      height: 2px
      border-radius: 2px
      background: rgba(122, 191, 255, 0.9)

.navbar nav.post span
  min-width: 24px

@media screen and (max-width: 768px)
  .navbar
    top: 10px !important
    margin: 0 12px 10px !important

  .navbar nav.post
    min-height: 40px
    gap: 14px
    padding-bottom: 3px

  .navbar nav.post a
    padding: 0 0 0.42rem !important
    font-size: 0.82rem

// ---------- 20. Smooth TOC navigation ----------
// 点击文章右侧目录时使用平滑滚动，并让当前目录项切换更柔和。
.l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link
  transition: color 0.22s ease, transform 0.22s ease, opacity 0.22s ease !important

.l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link:hover
  transform: translateX(3px)

.l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link.active
  transition: color 0.22s ease, transform 0.22s ease, font-weight 0.22s ease !important

@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior: auto

// 强覆盖：文章页右侧目录做成「竖线 + 短横」索引。
@media screen and (min-width: 1181px)
  .l_body[layout="post"] .l_right .widget-wrapper.toc .widget-body
    position: relative !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .widget-body::before
    display: none !important
    content: none !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc > .toc-item > a.toc-link,
  .l_body[layout="post"] .l_right .widget-wrapper.toc a.toc-link[href*="%E7%9B%AE%E5%BD%95"]
    display: none !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link
    position: relative !important
    display: block !important
    padding: 0.36rem 0 !important
    background: transparent !important
    border: none !important
    box-shadow: none !important
    color: rgba(235, 242, 255, 0.5) !important
    font-size: 0.84rem !important
    line-height: 1.48 !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link::before
    display: none !important
    content: none !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link .toc-text
    display: block !important
    max-width: 245px !important
    overflow: visible !important
    text-overflow: clip !important
    white-space: normal !important
    word-break: break-word !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link.active
    color: #a9d6ff !important
    font-weight: 700 !important

  .l_body[layout="post"] .l_right .widget-wrapper.toc .toc a.toc-link.active::before
    display: none !important
