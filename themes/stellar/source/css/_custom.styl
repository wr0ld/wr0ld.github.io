// 卡片meta信息：时间左、分类右
.post-card .meta.cap
  display: flex !important
  justify-content: space-between !important
  margin-top: 2px !important
  padding-top: 0 !important
  padding-bottom: 0 !important
  gap: 8px !important

// 卡片meta区域文字颜色（硬编码灰色，避免CSS变量动画时序问题）
