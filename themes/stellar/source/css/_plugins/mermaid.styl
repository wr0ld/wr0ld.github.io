pre.mermaid
  display: flex
  align-items: center
  justify-content: center
  font-family: $ff-body
  overflow: hidden
  max-width: 100%
  svg
    max-width: 100% !important
    height: auto !important

// Mermaid 全部文字强制黑色
.mermaid .label
  color: #000 !important
.mermaid .label text
  fill: #000 !important
.mermaid span
  color: #000 !important
.mermaid .cluster-label text
  fill: #000 !important
.mermaid .cluster-label span
  color: #000 !important
.mermaid .flowchartTitleText
  fill: #000 !important
