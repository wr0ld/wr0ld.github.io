<!-- 默认设置配置文件 -->
<script src="<%- url_for('/settings/defaults.js') %>"></script>
<script>
// 将 defaults.js 的默认值应用到 localStorage 空缺项
(function() {
  if (!window._siteDefaults) return;
  for (var k in window._siteDefaults) {
    if (localStorage.getItem(k) === null) {
      localStorage.setItem(k, window._siteDefaults[k]);
    }
  }
})();
</script>

<!-- Live2D Widget - Local Version -->
<script src="<%- url_for('/live2d-widget/dist/autoload.js') %>"></script>

<!-- Live2D Widget 位置调整 -->
<style>
  #waifu {
    position: fixed !important;
    bottom: 0 !important;
    right: 10px !important;
    left: auto !important;
    z-index: 1000 !important;
    transform: scale(var(--waifu-scale, 1)) !important;
    transform-origin: bottom right !important;
    /* 不覆盖 display，由 autoload.js 和 waifu.css 控制显隐 */
