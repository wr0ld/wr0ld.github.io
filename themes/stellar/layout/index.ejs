<%
if (page.menu_id == undefined) {
  page.menu_id = 'post';
}
if (page.title && page.wiki) {
  page.robots = 'noindex,follow';
}

function layout_post_card(layout, post, content) {
  var el = '';
  var layout = layout;
  if (layout == 'post' && post.cover != undefined && post.poster != undefined) {
    layout += ' photo';
  }
  el += `<a class="post-card${scrollreveal(' ')} ${layout}" href="${url_for(post.link || post.path)}">`
  el += content;
  el += '</a>';
  return el;
}

function layout_post_list(partial, layoutClass) {
  var el = '';
  el += `<div class="post-list post ${layoutClass}">`;
  page.posts.each(function(post){
    el += layout_post_card('post', post, partial(post));
  })
  el += '</div>';
  return el;
}

// 获取所有文章数据（用于仅标题布局显示全部文章）
var allPosts = [];
var postsSource = site.posts;
if (page.category) {
  var category = site.categories.findOne({name: page.category});
  if (category && category.posts) {
    postsSource = category.posts;
  }
}
if (postsSource && postsSource.sort) {
  postsSource.sort('date', -1).each(function(post) {
    allPosts.push({
      title: post.title || '无标题',
      path: post.path || '',
      link: post.link || ''
    });
  });
}

function safe_json(str) {
  return str.replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
}
%>

<%- partial('_partial/main/navbar/nav_tabs_blog') %>

<div class="layout-switcher">
  <button class="layout-toggle-btn" title="切换布局">
    <i class="fas fa-chevron-up"></i>
  </button>
  <div class="layout-options">
    <div class="options-section">
      <div class="options-label">布局方式 <span class="default-layout-hint">(默认: 网格)</span></div>
      <button class="layout-btn" data-layout="list"><span>列表</span></button>
      <button class="layout-btn active" data-layout="grid"><span>网格</span></button>
      <button class="layout-btn" data-layout="compact"><span>紧凑</span></button>
      <button class="layout-btn" data-layout="title-only"><span>仅标题</span></button>
    </div>
  </div>
</div>

<div id="post-container">
  <%- layout_post_list(function(post){
    return partial('_partial/main/post_list/post_card', {post: post, layout: 'grid'})
  }, 'grid') %>
</div>

<div id="paginator-wrapper">
  <%- partial('_partial/main/post_list/paginator') %>
</div>

<script>
  // 所有文章数据（用于仅标题布局）
  // eslint-disable-next-line
  const allPostsData = <%- safe_json(JSON.stringify(allPosts)) %>;
  
  // 布局切换功能
  (function() {
    // 将 layout-switcher 移到 body 下，避免父级 transform 导致 fixed 失效
    var ls = document.querySelector('.layout-switcher');
    if (ls && ls.parentNode !== document.body) {
      document.body.appendChild(ls);
    }

    // 强制修复卡片meta颜色（EJS模板已内联style，此处仅作兜底）
    var metaGray = 'rgba(160,165,180,0.85)';
    setTimeout(function() {
      document.querySelectorAll('.post-card .breadcrumb, .post-card .breadcrumb *').forEach(function(el) {
        if (!el.style.color || el.style.color.indexOf('rgba(160') === -1) el.style.color = metaGray;
      });
    }, 100);
    const layoutButtons = document.querySelectorAll('.layout-btn[data-layout]');
    const postContainer = document.getElementById('post-container');
    const paginatorWrapper = document.getElementById('paginator-wrapper');
    
    // 保存原始分页HTML
    const originalHTML = postContainer.innerHTML;
    
    // 从localStorage加载保存的布局
    const savedLayout = localStorage.getItem('Stellar.layout') || 'grid';
    
    // 渲染所有文章（仅标题模式）
    function renderAllPosts() {
      let html = '<div class="post-list post title-only">';
      allPostsData.forEach(function(post) {
        html += `<a class="post-card" href="${post.link || '/' + post.path}">`;
        html += `<div class="post-title">${post.title}</div>`;
        html += '</a>';
      });
      html += '</div>';
      postContainer.innerHTML = html;
    }
    
    // 应用布局
    function applyLayout(layout) {
      // 更新按钮状态
      layoutButtons.forEach(btn => {
        btn.classList.remove('active');
        if (btn.dataset.layout === layout) {
          btn.classList.add('active');
        }
      });
      
      // 仅标题布局：显示所有文章
      if (layout === 'title-only') {
        renderAllPosts();
        paginatorWrapper.style.display = 'none';
      } else {
        // 其他布局：恢复原始分页HTML
        postContainer.innerHTML = originalHTML;
        // 移除 slide-up 类（避免新 DOM 未被 ScrollReveal 观测导致隐藏）
        // 卡片入场效果由 CSS 动画 .post-card 自带动画兜底
        postContainer.querySelectorAll('.slide-up').forEach(function(el) {
          el.classList.remove('slide-up');
        });
        let postList = postContainer.querySelector('.post-list');
        postList.classList.remove('list', 'grid', 'compact', 'title-only');
        postList.classList.add(layout);
        paginatorWrapper.style.display = 'block';
      }
      
      // 保存布局到localStorage
      localStorage.setItem('Stellar.layout', layout);
      
      // 触发成就
      if (window.secret && window.secret.layoutSwitch) {
        window.secret.layoutSwitch();
      }
    }
    
    // 绑定布局按钮点击事件
    layoutButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const layout = this.dataset.layout;
        applyLayout(layout);
      });
    });
    
    // 初始化
    applyLayout(savedLayout);
  })();
</script>